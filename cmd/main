#!/bin/bash

# 1. 优先加载 fnOS 官方 Node.js 运行时路径与标准系统路径
export PATH="/var/apps/nodejs_v22/target/bin:/var/apps/nodejs_v24/target/bin:/var/apps/nodejs_v20/target/bin:/var/apps/nodejs/target/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# 2. 定位可用 node 二进制执行文件
NODE_BIN="node"
if command -v node >/dev/null 2>&1; then
    NODE_BIN="$(command -v node)"
else
    for candidate in \
        /var/apps/nodejs_v22/target/bin/node \
        /var/apps/nodejs_v24/target/bin/node \
        /var/apps/nodejs_v20/target/bin/node \
        /var/apps/nodejs*/target/bin/node \
        /usr/local/bin/node \
        /usr/bin/node \
        /opt/node/bin/node; do
        if [ -x "$candidate" ]; then
            NODE_BIN="$candidate"
            export PATH="$(dirname "$candidate"):$PATH"
            break
        fi
    done
fi

TRIM_PKGVAR="${TRIM_PKGVAR:-./var}"
TRIM_APPDEST="${TRIM_APPDEST:-.}"

# Storage defaults are resolved by configManager; startup never changes or migrates user storage.
mkdir -p "${TRIM_PKGVAR}/logs"

PID_FILE="${TRIM_PKGVAR}/server.pid"
LOG_FILE="${TRIM_PKGVAR}/logs/server.log"
SOCKET_FILE="${TRIM_APPDEST}/app.sock"
SERVER_JS="${TRIM_APPDEST}/server/app.js"
if [ ! -f "$SERVER_JS" ] && [ -f "${TRIM_APPDEST}/app/server/app.js" ]; then
    SERVER_JS="${TRIM_APPDEST}/app/server/app.js"
fi

is_server_running() {
    local pid="$1" state command
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    read -r state command < <(ps -ww -p "$pid" -o stat= -o args=) || return 1
    [[ "$state" != Z* ]] || return 1
    case "$command" in
        *" ${TRIM_APPDEST}/server/app.js") command=${command%" ${TRIM_APPDEST}/server/app.js"} ;;
        *" ${TRIM_APPDEST}/app/server/app.js") command=${command%" ${TRIM_APPDEST}/app/server/app.js"} ;;
        *) return 1 ;;
    esac
    [ "${command##*/}" = node ]
}

find_server_pid() {
    local pid
    if [ -f "$PID_FILE" ] && read -r pid < "$PID_FILE" && is_server_running "$pid"; then
        printf '%s\n' "$pid"
        return 0
    fi
    # Recover the service PID if an earlier stop removed its PID file prematurely.
    for pid in $(pgrep -f 'server/app\.js$' 2>/dev/null); do
        if is_server_running "$pid"; then
            printf '%s\n' "$pid"
            return 0
        fi
    done
    return 1
}

case "$1" in
    start)
        echo "Starting NovelAI backend service..."
        
        # Check if already running
        if pid=$(find_server_pid); then
            echo "NovelAI backend already running (PID: $pid)"
            exit 0
        fi

        # Remove stale socket
        rm -f "$SOCKET_FILE"

        export SOCKET_PATH="$SOCKET_FILE"
        export TRIM_APPDEST="$TRIM_APPDEST"
        export TRIM_PKGVAR="$TRIM_PKGVAR"
        export GATEWAY_PREFIX="/app/novelai"

        # 运行日志轮转：启动时归档上一份日志，保留最新 5 份历史归档 + 1 份当前运行中的 server.log
        if [ -f "$LOG_FILE" ] && [ -s "$LOG_FILE" ]; then
            ARCHIVE_NAME="server_$(date "+%Y-%m-%d_%H%M%S").log"
            mv "$LOG_FILE" "${TRIM_PKGVAR}/logs/${ARCHIVE_NAME}" 2>/dev/null || true
        fi
        # 清理超出 5 份的历史运行日志
        ls -t "${TRIM_PKGVAR}/logs"/server_*.log 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null || true

        if ! command -v "$NODE_BIN" >/dev/null 2>&1 && [ ! -x "$NODE_BIN" ]; then
            echo "[Error] Node.js 运行时未找到！请确保在飞牛应用中心已安装 Node.js v22 (nodejs_v22)。" >> "$LOG_FILE"
        fi

        nohup "$NODE_BIN" "$SERVER_JS" >> "$LOG_FILE" 2>&1 &
        pid=$!
        echo "$pid" > "$PID_FILE"

        # Wait up to 5 seconds for socket or startup
        for i in {1..10}; do
            if [ -S "$SOCKET_FILE" ] && is_server_running "$pid"; then
                echo "NovelAI service started successfully (PID: $pid)"
                exit 0
            fi
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.5
        done
        echo "NovelAI backend did not start. See $LOG_FILE" >&2
        exit 1
        ;;
    stop)
        echo "Stopping NovelAI backend service..."
        if pid=$(find_server_pid); then
            if ! kill -TERM "$pid" 2>/dev/null && is_server_running "$pid"; then
                echo "Could not stop NovelAI backend (PID: $pid)" >&2
                exit 1
            fi
            for ((attempt = 0; attempt < 80; attempt++)); do
                is_server_running "$pid" || break
                sleep 0.25
            done
            if is_server_running "$pid"; then
                echo "NovelAI backend is still shutting down (PID: $pid). See $LOG_FILE" >&2
                exit 1
            fi
        fi
        rm -f "$PID_FILE" "$SOCKET_FILE"
        ;;
    status)
        if find_server_pid >/dev/null; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|status}"
        exit 1
        ;;
esac
