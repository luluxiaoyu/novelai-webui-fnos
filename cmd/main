#!/bin/bash

# 1. 优先加载 fnOS 官方 Node.js 运行时路径与标准系统路径
export PATH="/var/apps/nodejs_v22/target/bin:/var/apps/nodejs_v24/target/bin:/var/apps/nodejs_v20/target/bin:/var/apps/nodejs/target/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# 2. 定位可用 node 二进制执行文件
NODE_BIN="node"
if command -v node >/dev/null 2>&1; then
    NODE_BIN="$(command -v node)"
else
    for candidate in \
        /var/apps/nodejs_v22/target/bin/node \
        /var/apps/nodejs_v24/target/bin/node \
        /var/apps/nodejs_v20/target/bin/node \
        /var/apps/nodejs*/target/bin/node \
        /usr/local/bin/node \
        /usr/bin/node \
        /opt/node/bin/node; do
        if [ -x "$candidate" ]; then
            NODE_BIN="$candidate"
            export PATH="$(dirname "$candidate"):$PATH"
            break
        fi
    done
fi

TRIM_PKGVAR="${TRIM_PKGVAR:-./var}"
TRIM_APPDEST="${TRIM_APPDEST:-.}"

# Detect fnOS data-share mount directory (for fnOS 文件管理)
SHARE_DIR=""
if [ -n "$TRIM_DATA_SHARE_PATHS" ]; then
    IFS=':;,' read -ra CANDIDATE_PATHS <<< "$TRIM_DATA_SHARE_PATHS"
    for candidate in "${CANDIDATE_PATHS[@]}"; do
        clean_c="$(echo "$candidate" | xargs)"
        if [ -n "$clean_c" ] && [ -d "$clean_c" ]; then
            SHARE_DIR="$clean_c"
            break
        fi
    done
fi

if [ -z "$SHARE_DIR" ]; then
    if [ -d "${TRIM_APPDEST}/share/NovelAI-WebUI" ]; then
        SHARE_DIR="${TRIM_APPDEST}/share/NovelAI-WebUI"
    elif [ -d "/var/apps/novelai/share/NovelAI-WebUI" ]; then
        SHARE_DIR="/var/apps/novelai/share/NovelAI-WebUI"
    elif [ -d "${TRIM_APPDEST}/shares/NovelAI-WebUI" ]; then
        SHARE_DIR="${TRIM_APPDEST}/shares/NovelAI-WebUI"
    elif [ -d "/var/apps/novelai/shares/NovelAI-WebUI" ]; then
        SHARE_DIR="/var/apps/novelai/shares/NovelAI-WebUI"
    elif [ -d "${TRIM_APPDEST}/share/NovelAI" ]; then
        SHARE_DIR="${TRIM_APPDEST}/share/NovelAI"
    elif [ -d "/var/apps/novelai/share/NovelAI" ]; then
        SHARE_DIR="/var/apps/novelai/share/NovelAI"
    elif [ -d "${TRIM_APPDEST}/shares/NovelAI" ]; then
        SHARE_DIR="${TRIM_APPDEST}/shares/NovelAI"
    elif [ -d "/var/apps/novelai/shares/NovelAI" ]; then
        SHARE_DIR="/var/apps/novelai/shares/NovelAI"
    fi
fi

if [ -z "$SHARE_DIR" ]; then
    for vol in 1 2 3 4 5 6 7 8 9; do
        if [ -d "/vol${vol}/@appshare/NovelAI-WebUI" ]; then
            SHARE_DIR="/vol${vol}/@appshare/NovelAI-WebUI"
            break
        elif [ -d "/vol${vol}/shares/NovelAI-WebUI" ]; then
            SHARE_DIR="/vol${vol}/shares/NovelAI-WebUI"
            break
        elif [ -d "/vol${vol}/share/NovelAI-WebUI" ]; then
            SHARE_DIR="/vol${vol}/share/NovelAI-WebUI"
            break
        fi
    done
fi

if [ -z "$SHARE_DIR" ]; then
    SHARE_DIR="${TRIM_PKGVAR}/data"
fi

mkdir -p "${SHARE_DIR}/profiles" "${SHARE_DIR}/logs" "${TRIM_PKGVAR}/logs"
chmod -R 777 "$SHARE_DIR" 2>/dev/null || true

# Migrate existing profiles data if available
if [ "$SHARE_DIR" != "${TRIM_PKGVAR}/data" ] && [ -d "${TRIM_PKGVAR}/data/profiles" ]; then
    cp -rn "${TRIM_PKGVAR}/data/profiles"/* "$SHARE_DIR/profiles/" 2>/dev/null || true
fi
if [ -d "${TRIM_APPDEST}/shares/NovelAI/profiles" ] && [ "$SHARE_DIR" != "${TRIM_APPDEST}/shares/NovelAI" ]; then
    cp -rn "${TRIM_APPDEST}/shares/NovelAI/profiles"/* "$SHARE_DIR/profiles/" 2>/dev/null || true
fi

PID_FILE="${TRIM_PKGVAR}/server.pid"
LOG_FILE="${SHARE_DIR}/logs/server.log"
SOCKET_FILE="${TRIM_APPDEST}/app.sock"

case "$1" in
    start)
        echo "Starting NovelAI backend service..."
        
        # Check if already running
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            echo "NovelAI backend already running (PID: $(cat "$PID_FILE"))"
            exit 0
        fi

        # Remove stale socket
        rm -f "$SOCKET_FILE"

        export SOCKET_PATH="$SOCKET_FILE"
        export TRIM_APPDEST="$TRIM_APPDEST"
        export TRIM_PKGVAR="$TRIM_PKGVAR"
        export NOVELAI_SHARE_DIR="$SHARE_DIR"
        export GATEWAY_PREFIX="/app/novelai"

        SERVER_JS="${TRIM_APPDEST}/server/app.js"
        if [ ! -f "$SERVER_JS" ] && [ -f "${TRIM_APPDEST}/app/server/app.js" ]; then
            SERVER_JS="${TRIM_APPDEST}/app/server/app.js"
        fi

        # 运行日志轮转：启动时归档上一份日志，保留最新 5 份历史归档 + 1 份当前运行中的 server.log
        if [ -f "$LOG_FILE" ] && [ -s "$LOG_FILE" ]; then
            ARCHIVE_NAME="server_$(date "+%Y-%m-%d_%H%M%S").log"
            mv "$LOG_FILE" "${SHARE_DIR}/logs/${ARCHIVE_NAME}" 2>/dev/null || true
        fi
        # 清理超出 5 份的历史运行日志
        ls -t "${SHARE_DIR}/logs"/server_*.log 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null || true

        if ! command -v "$NODE_BIN" >/dev/null 2>&1 && [ ! -x "$NODE_BIN" ]; then
            echo "[Error] Node.js 运行时未找到！请确保在飞牛应用中心已安装 Node.js v22 (nodejs_v22)。" >> "$LOG_FILE"
        fi

        nohup "$NODE_BIN" "$SERVER_JS" >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"

        # Wait up to 5 seconds for socket or startup
        for i in {1..10}; do
            if [ -S "$SOCKET_FILE" ] || kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
                echo "NovelAI service started successfully (PID: $(cat "$PID_FILE"))"
                break
            fi
            sleep 0.5
        done

        exit 0
        ;;
    stop)
        echo "Stopping NovelAI backend service..."
        if [ -f "$PID_FILE" ]; then
            kill -TERM "$(cat "$PID_FILE")" 2>/dev/null || true
            rm -f "$PID_FILE"
        fi
        
        # Remove socket
        rm -f "$SOCKET_FILE"

        pkill -TERM -f "${TRIM_APPDEST}/.*server/app\.js" 2>/dev/null || true
        sleep 0.5
        pkill -9 -f "${TRIM_APPDEST}/.*server/app\.js" 2>/dev/null || true

        exit 0
        ;;
    status)
        if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|status}"
        exit 1
        ;;
esac
