#!/bin/bash

echo "Uninstalling NovelAI package..."

PID_FILE="${TRIM_PKGVAR}/server.pid"
if [ -f "$PID_FILE" ]; then
    kill -TERM "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
fi

pkill -TERM -f "${TRIM_APPDEST}/.*server/app\.js" 2>/dev/null || true
sleep 0.5
pkill -9 -f "${TRIM_APPDEST}/.*server/app\.js" 2>/dev/null || true

rm -f "${TRIM_APPDEST}/app.sock"

exit 0
